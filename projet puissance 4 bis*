def creer_grille():
    grille = []
    for i in range(6):
        ligne = [" "] * 7
        grille.append(ligne)
    return grille

def afficher_grille(grille):
    for ligne in grille:
        print("|", end="")
        for case in ligne:
            print(case, end="|")
        print()
    print(" 0 1 2 3 4 5 6")

def jouer(grille, colonne, joueur):
    for ligne in range(5, -1, -1):
        if grille[ligne][colonne] == " ":
            grille[ligne][colonne] = joueur
        return True
    return False

def victoire(grille, joueur):
    for i in range(6):
        for j in range(4):
            if grille[i][j] == joueur and grille[i][j+1] == joueur and grille[i][j+2] == joueur and grille[i][j+3] == joueur:
                return True
    return False

def main():
    grille = creer_grille()
    joueur = "X"

    while True:
        afficher_grille(grille)
        col = int(input("Choisir une colonne (0-6): "))

        if jouer(grille, col, joueur):
            if victoire(grille, joueur):
                afficher_grille(grille)
                print("Le joueur", joueur, "a gagné !")
                break

            if joueur == "X":
                joueur = "O"
            else:
                joueur = "X"
        else:
            print("Colonne pleine")

main()
